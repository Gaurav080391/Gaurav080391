      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (controller_name) (up{controller_name=~\"$Controller\"})",
          "instant": true,
          "legendFormat": "{{controller_name}}",
          "range": false,
          "refId": "A"
        }
      ],
