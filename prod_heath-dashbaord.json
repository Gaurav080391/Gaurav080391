                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "controller_name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Jenkins Master"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Status"
              }
            ]
          }
        ]
