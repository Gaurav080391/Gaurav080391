        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background"
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
