{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0,211,255,1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Jenkins Build Performance Dashboard",
  "editable": true,
  "graphTooltip": 1,
  "liveNow": true,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "UID"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(default_jenkins_executor_count_value{controller_name=~\"$Controller\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Total Executors",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "UID"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "100 * (sum(default_jenkins_executor_count_value{controller_name=~\"$Controller\"}) - sum(default_jenkins_executor_free_count_value{controller_name=~\"$Controller\"})) / sum(default_jenkins_executor_count_value{controller_name=~\"$Controller\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Executor Usage %",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "UID"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(default_jenkins_queue_size_value{controller_name=~\"$Controller\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Build Queue Size",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "UID"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "count(up{controller_name=~\"$Controller\"} == 1)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Controllers UP",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "UID"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "default_jenkins_queue_size_value{controller_name=~\"$Controller\"}",
          "legendFormat": "{{controller_name}}",
          "refId": "A"
        }
      ],
      "title": "Queue Trend Per Controller",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "UID"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "100 * (default_jenkins_executor_count_value{controller_name=~\"$Controller\"} - default_jenkins_executor_free_count_value{controller_name=~\"$Controller\"}) / default_jenkins_executor_count_value{controller_name=~\"$Controller\"}",
          "legendFormat": "{{controller_name}}",
          "refId": "A"
        }
      ],
      "title": "Executor Utilization Trend",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "UID"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background"
            }
          }
        }
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 7,
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "expr": "default_jenkins_queue_size_value{controller_name=~\"$Controller\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "default_jenkins_executor_count_value{controller_name=~\"$Controller\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "default_jenkins_executor_free_count_value{controller_name=~\"$Controller\"}",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "up{controller_name=~\"$Controller\"}",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "title": "Controller Build Performance Table",
      "type": "table"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": [
    "jenkins",
    "build",
    "performance"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "UID"
        },
        "includeAll": true,
        "label": "Controller",
        "multi": true,
        "name": "Controller",
        "query": "label_values(up, controller_name)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Jenkins Build Performance Dashboard",
  "uid": "jenkins-build-performance",
  "version": 1
}
