Scripted vs Declarative Pipeline in Jenkins
Both are ways to define Jenkins pipelines as code, but they differ significantly in syntax, flexibility, and ease of use.
Scripted Pipeline
The original pipeline syntax — pure Groovy code wrapped in a node block. You have full programmatic control.
node('linux-agent') {
    def deployEnv = 'staging'
    def imageTag = ''

    try {
        stage('Checkout') {
            checkout scm
        }

        stage('Build & Test') {
            parallel(
                unitTests: {
                    sh 'mvn test -Dtest=UnitTests'
                },
                integrationTests: {
                    sh 'mvn test -Dtest=IntegrationTests'
                }
            )
        }

        stage('Docker Build') {
            imageTag = sh(
                script: "git rev-parse --short HEAD",
                returnStdout: true
            ).trim()
            sh "docker build -t myapp:${imageTag} ."
        }

        stage('Deploy') {
            if (env.BRANCH_NAME == 'main') {
                deployEnv = 'production'
            }
            sh "helm upgrade --install myapp ./chart --set image.tag=${imageTag} --namespace ${deployEnv}"
        }

    } catch (Exception e) {
        currentBuild.result = 'FAILURE'
        slackSend(color: 'danger', message: "Build failed: ${e.message}")
        throw e
    } finally {
        cleanWs()
    }
}
Key traits: node {} at root, full Groovy, manual try/catch, no enforced structure.
Declarative Pipeline
The modern, structured syntax introduced later. Jenkins parses it — you declare what you want, not how to do it.
pipeline {
    agent { label 'linux-agent' }

    environment {
        IMAGE_TAG = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
        DEPLOY_ENV = 'staging'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        retry(2)
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            parallel {
                stage('Unit Tests') {
                    steps { sh 'mvn test -Dtest=UnitTests' }
                }
                stage('Integration Tests') {
                    steps { sh 'mvn test -Dtest=IntegrationTests' }
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -t myapp:${IMAGE_TAG} ."
            }
        }

        stage('Deploy') {
            when {
                branch 'main'
            }
            steps {
                sh "helm upgrade --install myapp ./chart --set image.tag=${IMAGE_TAG} --namespace production"
            }
        }
    }

    post {
        failure {
            slackSend(color: 'danger', message: "Build failed on ${env.BRANCH_NAME}")
        }
        always {
            cleanWs()
        }
    }
}
Key traits: pipeline {} at root, enforced structure, built-in post, when, options, environment blocks.
